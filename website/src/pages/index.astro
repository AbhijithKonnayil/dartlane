  <!-- Interactive Scripts (Theme toggle, Copy button) -->
  <script is:inline>
    // Hero terminal: type the commands, run each step, then loop.
    (function () {
      const term = document.getElementById('hero-terminal');
      if (!term || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const steps = [...term.querySelectorAll('[data-step]')];
      const typed = [...term.querySelectorAll('[data-type]')];
      const texts = new Map(typed.map((el) => [el, el.textContent]));
      const badges = new Map(
        [...term.querySelectorAll('[data-final]')].map((el) => [el, el.dataset.final]),
      );
      const logo = document.querySelector('.hero-logo');
      const wait = (ms) => new Promise((r) => setTimeout(r, ms));
      let token = 0;
      let done = 0;


      // 3D orbit (desktop only): the dart circles the terminal on a tilted
      // ring, passing in front of it at the bottom and behind it at the top,
      // one third of a lap per step. The terminal leans as the dart passes.
      const SVG = 'http://www.w3.org/2000/svg';
      const flightOK = () => window.matchMedia('(min-width: 1024px)').matches;
      const C = { x: 410, y: 305 };       // centre of the dart in logo units
      const TAIL = { x: 600, y: 250 };    // where the trail attaches
      const TIP = 141.8;                  // heading of the dart at rest (deg)
      const FLY_SCALE = 0.55;
      const PERSPECTIVE = 900;            // px

      const flight = (() => {
        if (!logo) return null;
        const fly = logo.querySelector('.hl-fly');
        const core = logo.querySelector('.hl-core');
        const streakGroup = logo.querySelector('.hl-streaks');
        const hole = logo.querySelector('.hl-hole');
        const pulses = logo.querySelector('.hl-pulses');
        const win = term.closest('.terminal-window');
        const hero = win.parentElement;
        const st = {
          gen: 0, p: 0, mix: 0, on: false, geo: null, raf: 0, home: true, behindOK: false, behind: 0,
          tilt: { x: 0, y: 0 }, mouse: { x: 0, y: 0 },
        };
        const RAD = Math.PI / 180;

        // The orange streaks are ropes: the head is pinned to the dart, and
        // every point follows the one before it. At rest they are the logo's
        // waves; in flight they stretch into the motion trail; on landing
        // they flow back into the waves.
        const streaks = [...logo.querySelectorAll('.hl-streak')].map((el) => {
          const rest = JSON.parse(el.dataset.pts);
          const width = JSON.parse(el.dataset.w);
          return {
            el, rest, width,
            home: el.getAttribute('d'),
            seg: rest.slice(1).map((q, i) => Math.hypot(q[0] - rest[i][0], q[1] - rest[i][1])),
            pts: rest.map((q) => q.slice()),
          };
        });

        // The flight path, in logo units, with z > 0 away from us. It is a
        // tilted loop on the diagonal from the dart's corner (top right)
        // to the opposite corner (bottom left): the dart sweeps down in
        // front of the terminal, turns at the bottom left, and returns
        // behind it.
        function measure() {
          const sr = logo.getBoundingClientRect();
          const tr = win.getBoundingClientRect();
          const k = 720 / sr.width;
          const cx = ((tr.left + tr.right) / 2 - sr.left) * k;
          const cy = ((tr.top + tr.bottom) / 2 - sr.top) * k;
          const tx = C.x - cx, ty = C.y - cy;     // centre -> top right
          const len = Math.hypot(tx, ty);
          st.geo = {
            cx, cy, tx, ty,
            bx: -1.1 * tx, by: -1.1 * ty,        // centre -> bottom left
            nx: -ty / len, ny: tx / len,           // bows toward bottom right
            bow: 0.34 * len,
            hw: (tr.width / 2) * k, hh: (tr.height / 2) * k,
            rz: 220 * k, f: PERSPECTIVE * k, k,
          };
        }

        function ring(p) {
          const g = st.geo;
          const a = p * 2 * Math.PI, c = Math.cos(a), sn = Math.sin(a);
          const along = c >= 0 ? [g.tx * c, g.ty * c] : [g.bx * -c, g.by * -c];
          const x = along[0] + g.nx * g.bow * sn;
          const y = along[1] + g.ny * g.bow * sn;
          const z = -g.rz * sn;                    // in front on the way down
          const d = g.f / (g.f + z);
          return { x: g.cx + x * d, y: g.cy + y * d, z, d, X: x, Y: y };
        }

        function pose() {
          const g = st.geo, mix = st.mix;
          const a = ring(st.p), b = ring(st.p + 0.002);
          // Heading on screen, and how much of the motion is toward or away
          // from us (the dart foreshortens when it flies along the view axis).
          let heading = (Math.atan2(b.y - a.y, b.x - a.x) / RAD);
          heading = ((heading + 180) % 360 + 360) % 360 - 180;
          const real = Math.hypot(b.X - a.X, b.Y - a.Y, (b.z - a.z));
          const seen = Math.hypot(b.x - a.x, b.y - a.y) / a.d;
          const fore = Math.min(1, Math.max(0.3, seen / (real || 1)));
          return {
            x: C.x + (a.x - C.x) * mix,
            y: C.y + (a.y - C.y) * mix,
            h: TIP + mix * (heading - TIP),
            fx: 1 + mix * (fore - 1),
            s: 1 + (FLY_SCALE * a.d - 1) * mix,
            z: a.z, d: a.d, X: a.X, Y: a.Y,
          };
        }

        function ribbon(pts, w) {
          const L = [], R = [];
          pts.forEach((q, i) => {
            const a = pts[Math.max(0, i - 1)], b = pts[Math.min(pts.length - 1, i + 1)];
            const dx = b[0] - a[0], dy = b[1] - a[1], n = Math.hypot(dx, dy) || 1;
            const h = w[i] / 2;
            L.push(`${(q[0] - (dy / n) * h).toFixed(1)} ${(q[1] + (dx / n) * h).toFixed(1)}`);
            R.push(`${(q[0] + (dy / n) * h).toFixed(1)} ${(q[1] - (dx / n) * h).toFixed(1)}`);
          });
          return `M${L.join('L')}L${R.reverse().join('L')}Z`;
        }

        // Where a point fixed to the dart (logo units at rest) is now.
        function toWorld(q, o) {
          let vx = (q[0] - C.x) * o.s, vy = (q[1] - C.y) * o.s;
          const t = -TIP * RAD, h = o.h * RAD;
          [vx, vy] = [vx * Math.cos(t) - vy * Math.sin(t), vx * Math.sin(t) + vy * Math.cos(t)];
          vx *= o.fx;
          return [o.x + vx * Math.cos(h) - vy * Math.sin(h), o.y + vx * Math.sin(h) + vy * Math.cos(h)];
        }

        function setHome() {
          streaks.forEach((sk) => {
            sk.pts = sk.rest.map((q) => q.slice());
            sk.head = null;
            sk.el.setAttribute('d', sk.home);
          });
          core.setAttribute('d', '');
          st.home = true;
        }

        function moveStreaks(o) {
          const m = st.mix;
          const home = 1 - Math.min(1, m / 0.7);            // 1 once fully back in the logo
          const lengthScale = o.s * (1 + 1.6 * m);
          const widthScale = o.s * (1 + 0.5 * m);
          streaks.forEach((sk, k) => {
            // Move the head in small steps, so the rope follows the path the
            // dart actually took instead of cutting straight to it.
            const from = sk.head || sk.pts[0], to = toWorld(sk.rest[0], o);
            const steps = Math.max(1, Math.min(80, Math.ceil(Math.hypot(to[0] - from[0], to[1] - from[1]) / 4)));
            for (let j = 1; j <= steps; j++) {
              const u = j / steps;
              sk.pts[0] = [from[0] + (to[0] - from[0]) * u, from[1] + (to[1] - from[1]) * u];
              for (let i = 1; i < sk.pts.length; i++) {
                const a = sk.pts[i - 1], b = sk.pts[i];
                const dx = b[0] - a[0], dy = b[1] - a[1], n = Math.hypot(dx, dy) || 1;
                const len = sk.seg[i - 1] * lengthScale;
                sk.pts[i] = [a[0] + (dx / n) * len, a[1] + (dy / n) * len];
              }
            }
            sk.head = to;
            const last = sk.pts.length - 1;
            const mixed = sk.pts.map((q, i) => [q[0] + (sk.rest[i][0] - q[0]) * home, q[1] + (sk.rest[i][1] - q[1]) * home]);
            // One light smoothing pass takes out any remaining kinks.
            const pts = mixed.map((q, i) => (i === 0 || i === last ? q : [
              (mixed[i - 1][0] + 2 * q[0] + mixed[i + 1][0]) / 4,
              (mixed[i - 1][1] + 2 * q[1] + mixed[i + 1][1]) / 4,
            ]));
            // The waves are fat in the middle; a trail is fat at the head.
            const width = sk.width.map((w, i) => {
              const comet = 46 * Math.pow(1 - i / last, 1.3);
              return (w + (comet - w) * m) * widthScale;
            });
            sk.el.setAttribute('d', ribbon(pts, width));
            if (k === 0) {
              core.setAttribute('d', ribbon(pts, width.map((w, i) => (i / last < 0.85 ? w * 0.3 : 0))));
              core.style.opacity = (m * 0.9).toFixed(2);
            }
          });
          st.home = false;
        }

        function leanTerminal(o) {
          const g = st.geo;
          // While flying the terminal leans toward the dart; otherwise it follows the pointer.
          const fx = g ? Math.max(-1, Math.min(1, o.X / g.hw)) * 7 : 0;
          const fy = g ? Math.max(-1, Math.min(1, o.Y / g.hh)) * 3.5 : 0;
          const tx = st.mix * -fx + (1 - st.mix) * st.mouse.x * 6;
          const ty = st.mix * fy + (1 - st.mix) * -st.mouse.y * 4;
          st.tilt.x += (tx - st.tilt.x) * 0.1;
          st.tilt.y += (ty - st.tilt.y) * 0.1;
          const still = Math.abs(tx - st.tilt.x) < 0.02 && Math.abs(ty - st.tilt.y) < 0.02;
          win.style.transform = still && !tx && !ty
            ? ''
            : `perspective(${PERSPECTIVE * 1.6}px) rotateY(${st.tilt.x.toFixed(2)}deg) rotateX(${st.tilt.y.toFixed(2)}deg)`;
          return !still;
        }

        function frame(now) {
          if (!st.geo) measure();
          const o = pose();
          fly.setAttribute(
            'transform',
            `translate(${o.x.toFixed(1)} ${o.y.toFixed(1)}) rotate(${o.h.toFixed(1)}) scale(${o.fx.toFixed(3)} 1) rotate(${-TIP}) scale(${o.s.toFixed(3)}) translate(${-C.x} ${-C.y})`,
          );
          const far = Math.max(0, o.z / st.geo.rz);
          fly.style.opacity = (1 - st.mix * 0.4 * far).toFixed(2);
          // Going behind the terminal: while the dart is on the far side of its
          // loop, the part of it that overlaps the terminal is masked out. It
          // fades in and out, so nothing ever pops between in front and behind.
          if (st.mix > 0.95) st.behindOK = true;
          else if (st.mix < 0.5) st.behindOK = false;
          st.behind += ((st.behindOK && o.z > 0 ? 1 : 0) - st.behind) * 0.2;
          if (st.behind > 0.005) {
            const sr = logo.getBoundingClientRect(), tr = win.getBoundingClientRect(), k = st.geo.k;
            hole.setAttribute('x', ((tr.left - sr.left) * k).toFixed(1));
            hole.setAttribute('y', ((tr.top - sr.top) * k).toFixed(1));
            hole.setAttribute('width', (tr.width * k).toFixed(1));
            hole.setAttribute('height', (tr.height * k).toFixed(1));
            hole.setAttribute('rx', (14 * k).toFixed(1));
          }
          hole.setAttribute('fill-opacity', st.behind.toFixed(3));
          if (st.on || st.mix > 0.001) moveStreaks(o);
          else if (!st.home) setHome();
          const leaning = leanTerminal(o);
          st.raf = st.on || !st.home || st.behind > 0.005 || leaning ? requestAnimationFrame(frame) : 0;
        }

        function kick() {
          if (!st.raf) st.raf = requestAnimationFrame(frame);
        }

        function tween(ms, fn, my) {
          return new Promise((res) => {
            const t0 = performance.now();
            (function step(now) {
              if (my !== st.gen) return res();
              const u = Math.min(1, (now - t0) / ms);
              fn(u);
              if (u < 1) requestAnimationFrame(step); else res();
            })(t0);
          });
        }
        const ease = (u) => (u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2);

        hero.addEventListener('pointermove', (e) => {
          if (!flightOK() || e.pointerType === 'touch') return;
          const r = hero.getBoundingClientRect();
          st.mouse.x = ((e.clientX - r.left) / r.width - 0.5) * 2;
          st.mouse.y = ((e.clientY - r.top) / r.height - 0.5) * 2;
          if (!st.geo) measure();
          kick();
        });
        hero.addEventListener('pointerleave', () => {
          st.mouse.x = 0; st.mouse.y = 0;
          kick();
        });
        window.addEventListener('resize', () => { st.geo = null; });

        return {
          reset() {
            st.gen++;
            st.p = 0; st.mix = 0; st.on = false; st.geo = null; st.behindOK = false; st.behind = 0;
            win.classList.remove('orbiting');
            hole.setAttribute('fill-opacity', '0');
            pulses.replaceChildren();
            fly.removeAttribute('transform');
            fly.style.opacity = '';
            setHome();
            kick();
          },
          mask(on) {
            if (on) streakGroup.setAttribute('mask', 'url(#hl-streak-mask)');
            else streakGroup.removeAttribute('mask');
          },
          // One continuous flight: speed up out of the corner, cruise, then slow
          // into the corner while the dart turns back into its resting pose.
          // The steps in the terminal just line up with it.
          async run(total, onLand) {
            const my = st.gen;
            measure();
            st.on = true;
            win.classList.add('orbiting');
            kick();
            const A = 0.1, B = 0.3, vmax = 1 / (1 - (A + B) / 2);
            let landed = false;
            await tween(total, (u) => {
              st.p = u < A ? (vmax * u * u) / (2 * A)
                : u > 1 - B ? 1 - (vmax * (1 - u) * (1 - u)) / (2 * B)
                : vmax * (A / 2 + (u - A));
              const out = ease(Math.min(1, u / 0.14));
              const home = u > 1 - B ? ease((u - (1 - B)) / B) : 0;
              st.mix = out * (1 - home);
              if (u > 1 - B && !landed) { landed = true; if (onLand) onLand(); }
            }, my);
            if (my === st.gen) {
              st.p = 1; st.mix = 0; st.on = false;
              win.classList.remove('orbiting');
            }
          },
          pulse() {
            const o = pose();
            const c = document.createElementNS(SVG, 'circle');
            c.setAttribute('class', 'hl-pulse');
            c.setAttribute('cx', o.x.toFixed(1));
            c.setAttribute('cy', o.y.toFixed(1));
            c.setAttribute('r', (70 * o.d).toFixed(1));
            c.addEventListener('animationend', () => c.remove());
            pulses.appendChild(c);
          },
        };
      })();

      function burst() {
        if (!logo) return;
        logo.classList.remove('burst');
        void logo.getBoundingClientRect();
        logo.classList.add('burst');
      }

      function reset() {
        steps.forEach((el) => el.classList.remove('show'));
        typed.forEach((el) => { el.textContent = ''; el.classList.remove('typing'); });
        badges.forEach((_, el) => el.classList.remove('running'));
        done = 0;
        if (flight) flight.reset();
        if (logo) logo.setAttribute('class', 'hero-logo is-animating');
      }

      async function type(el) {
        const text = texts.get(el);
        el.classList.add('typing');
        for (let i = 1; i <= text.length; i++) {
          el.textContent = text.slice(0, i);
          await wait(35 + Math.random() * 35);
        }
        el.classList.remove('typing');
      }

      async function play(my) {
        const alive = () => my === token;
        reset();
        const orbit = !!flight && flightOK();
        if (flight) flight.mask(!orbit);
        await wait(600);
        for (const el of steps) {
          if (!alive()) return;
          el.classList.add('show');
          const cmd = el.querySelector('[data-type]');
          const badge = el.querySelector('[data-final]');
          if (cmd) {
            await type(cmd);
            await wait(350);
            // Pressing enter on the lane command sends the dart off.
            if (el.hasAttribute('data-launch') && logo) {
              if (orbit) { logo.classList.add('flying'); flight.run(4000, () => logo.classList.add('go')); }
              else {
                logo.classList.add('fly', 'nudge');
                setTimeout(() => alive() && logo.classList.add('go'), 700);
              }
            }
          }
          else if (badge) {
            badge.textContent = 'running';
            badge.classList.add('running');
            const last = done === 2;
            if (orbit) await wait(last ? 1500 : 1100);
            else await wait(900 + Math.random() * 500);
            if (!alive()) return;
            badge.classList.remove('running');
            badge.textContent = badges.get(badge);
            if (logo) logo.classList.add('s' + ++done);
            if (orbit) { if (!last) flight.pulse(); } else burst();
            await wait(150);
          } else {
            if (logo && el.classList.contains('success-ribbon')) {
              logo.classList.add('hit');
            }
            await wait(450);
          }
        }
        await wait(5000);
        if (alive()) play(my);
      }

      term.classList.add('is-animating');
      if (logo) logo.classList.add('is-animating');
      // Only animate while visible, and restart cleanly when it comes back.
      new IntersectionObserver((entries) => {
        const visible = entries.some((e) => e.isIntersecting);
        token++;
        if (visible) play(token);
      }, { threshold: 0.3 }).observe(term);
    })();

    // Copy Command logic
    const copyBtn = document.getElementById('copy-cmd-btn');
    const copyText = document.getElementById('copy-text');
    const copyIcon = document.getElementById('copy-icon');
    const cliText = document.getElementById('cli-command-text')?.innerText || 'dart pub global activate dartlane';

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(cliText);
          if (copyText) copyText.innerText = 'Copied!';
          if (copyIcon) copyIcon.innerText = 'check';
          setTimeout(() => {
            if (copyText) copyText.innerText = 'Copy';
            if (copyIcon) copyIcon.innerText = 'content_copy';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy', err);
        }
      });
    }

    // Theme Switcher logic
    const themeBtn = document.getElementById('theme-toggle');
    const themeIcon = themeBtn?.querySelector('.theme-icon');

    function updateThemeUI(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.classList.toggle('dark', theme === 'dark');
      document.documentElement.classList.toggle('light', theme === 'light');
      if (themeIcon) {
        themeIcon.innerText = theme === 'dark' ? 'light_mode' : 'dark_mode';
        themeBtn.setAttribute('title', theme === 'dark' ? 'Switch to Light mode' : 'Switch to Dark mode');
      }
    }

    // Sync initial icon with current theme
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    updateThemeUI(currentTheme);

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const activeTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
        const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
        updateThemeUI(newTheme);
        try {
          localStorage.setItem('starlight-theme', newTheme);
        } catch (e) {}
      });
    }
  </script>
</Landing>
